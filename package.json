{
  "name": "thesys",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "eval:research": "python3 scripts/eval_research_sprints.py",
    "eval:ai": "python3 scripts/eval_ai_quality.py",
    "eval:extraction": "python3 scripts/eval_extraction_quality.py",
    "eval:quality": "python3 scripts/eval_quality_gate.py",
    "security:redteam:fast": "pnpm dlx promptfoo@0.121.15 eval -c security/redteam/promptfooconfig.fast.yaml",
    "security:redteam:full": "pnpm dlx promptfoo@0.121.15 eval -c security/redteam/promptfooconfig.full.yaml",
    "web:dev": "pnpm --filter thesys-web dev",
    "web:build": "pnpm --filter thesys-web build",
    "web:typecheck": "pnpm --filter thesys-web typecheck"
  }
}
